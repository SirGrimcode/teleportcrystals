{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      { "when": "overworld", "model": { "type": "minecraft:model", "model": "teleportcrystals:item/teleport_stone_overworld" } },
      { "when": "nether", "model": { "type": "minecraft:model", "model": "teleportcrystals:item/teleport_stone_nether" } },
      { "when": "end", "model": { "type": "minecraft:model", "model": "teleportcrystals:item/teleport_stone_end" } }
    ],
    "fallback": { "type": "minecraft:model", "model": "teleportcrystals:item/teleport_stone_clear" }
  }
}
